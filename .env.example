# Шаблон конфигурации. Скопируй в .env и заполни. Реальный .env не коммитится.
# Все переменные валидируются zod при старте приложений (итерации 3+).
# В автотестах реальные значения из .env не используются никогда.

# --- Домен ---
DOMAIN=example.com                      # поддомены: livekit.<домен>, app.<домен>, n8n.<домен>

# --- Postgres ---
POSTGRES_DB=restaurant
POSTGRES_USER=app_owner
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://app_owner:change-me@localhost:5432/restaurant

# --- LiveKit ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Mistral (STT Voxtral Realtime, LLM Mistral Large 3, TTS de/en) ---
MISTRAL_API_KEY=

# --- ElevenLabs (TTS на фазе разработки; перед продом — EU-residency + DPA или Piper) ---
ELEVENLABS_API_KEY=

# --- TTS-роутер: voxtral | elevenlabs | piper (piper появится в итерации 14) ---
TTS_PROVIDER_DE=elevenlabs
TTS_PROVIDER_EN=elevenlabs
TTS_PROVIDER_RU=elevenlabs

# --- n8n ---
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=                     # общий секрет HMAC-подписи вебхуков, 32+ байта

# --- Telegram (используется workflow n8n; в сообщения не передаются имя и телефон) ---
TELEGRAM_BOT_TOKEN=

# --- Портал ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=                    # bcrypt, cost 12; см. portal/scripts/hash-password.ts (итерация 9)
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD_HASH=
SESSION_SECRET=                         # 32+ байта, подпись httpOnly-cookie
