# Шаблон конфигурации. Скопируй в .env и заполни. Реальный .env не коммитится.
# Все переменные валидируются zod при старте приложений (итерации 3+).
# В автотестах реальные значения из .env не используются никогда.

# --- Домен ---
DOMAIN=example.com                      # поддомены: livekit.<домен>, app.<домен>, n8n.<домен>

# --- Postgres ---
POSTGRES_DB=restaurant
POSTGRES_USER=app_owner
POSTGRES_PASSWORD=change-me
# Локальный dev-контейнер слушает 55432, чтобы не спорить с нативным PostgreSQL,
# который часто уже занимает 5432 на машине разработчика. На сервере порт
# наружу не публикуется вообще (PROJECT.md §3.1).
DATABASE_URL=postgres://app_owner:app_owner@127.0.0.1:55432/restaurant
AGENT_APP_PASSWORD=                     # [A-Za-z0-9_-]{16,128}
N8N_APP_PASSWORD=                       # [A-Za-z0-9_-]{16,128}
PORTAL_APP_PASSWORD=                    # [A-Za-z0-9_-]{16,128}
WEBSITE_APP_PASSWORD=                   # [A-Za-z0-9_-]{16,128}
TEST_DATABASE_URL=postgres://app_owner:app_owner@127.0.0.1:55432/postgres

# --- LiveKit ---
LIVEKIT_URL=ws://localhost:7880
# Локальный livekit --dev использует devkey / secret. Никогда не использовать их в production.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- OpenAI (STT, LLM, TTS) ---
OPENAI_API_KEY=
STT_MODEL=gpt-transcribe
TTS_MODEL=tts-1
# Один голос может говорить на всех трёх языках. Значения на язык необязательны:
# пусто — используется общий TTS_VOICE.
TTS_VOICE=alloy
TTS_VOICE_DE=
TTS_VOICE_RU=
TTS_VOICE_EN=
LLM_MODEL=gpt-5.6-terra
# Для голосового пути оставьте none: серверное значение Terra по умолчанию medium
# увеличивает паузу перед ответом.
LLM_REASONING_EFFORT=none
# Необязательно. Для EU data residency нужен соответствующий проект OpenAI с ZDR;
# только после его настройки раскомментируйте адрес ниже.
# OPENAI_BASE_URL=https://eu.api.openai.com/v1

# Сколько миллисекунд тишины считается концом вашей реплики (100..5000).
# Это порог серверного VAD OpenAI: он закрывает сегмент и отдаёт финальную расшифровку,
# после которой агент начинает отвечать. Больше — агент
# ждёт дольше и не перебивает вас на паузах внутри фразы; меньше — отвечает быстрее.
STT_VAD_SILENCE_THRESHOLD_MS=500

# --- Поведение агента ---
# Язык приветствия и объявления об ИИ; дальше язык определяется по речи гостя.
AGENT_DEFAULT_LANGUAGE=ru
# Языки, на которые агенту разрешено переключаться. Должен содержать AGENT_DEFAULT_LANGUAGE.
AGENT_ENABLED_LANGUAGES=de,ru,en
# Сколько подряд идущих реплик на другом языке нужно для переключения (1..5).
# Смысл порога — не переключаться от одного иностранного слова (PROJECT.md §4.1).
AGENT_LANGUAGE_SWITCH_AFTER=2
AGENT_TURN_DETECTOR=multilingual
AGENT_MIN_ENDPOINTING_DELAY_MS=500
AGENT_MAX_ENDPOINTING_DELAY_MS=3000
# Пишет в лог всю цепочку разговора: распознанную речь гостя (stage=stt) и ответ модели,
# уходящий в TTS (stage=llm), строками `agent_transcript`. Это персональные данные, поэтому
# по умолчанию выключено (PROJECT.md §0.4, §11.3): включать только для отладки на вымышленных
# данных и выключать до разговора с реальным клиентом. Задержки звеньев пишутся всегда,
# независимо от этого флага, — строкой `agent_turn_latency` на уровне info.
AGENT_LOG_TRANSCRIPTS=false

# LiveKit Agents 1.6.4 пишет текст реплик (`newTranscript`, `forwardedText`) на уровне info,
# поэтому для живого разговора — в том числе тестового звонка из портала — ставьте warn.
# debug выводит ещё больше: только для синтетических тестов, не для клиентов.
LOG_LEVEL=warn

# --- Прямой доступ инструментов агента к Postgres RPC ---
# Только роль agent_app: без прав на таблицы, с EXECUTE на бронь и актуальное меню.
AGENT_DATABASE_URL=postgres://agent_app:<AGENT_APP_PASSWORD>@127.0.0.1:55432/restaurant
AGENT_DATABASE_TIMEOUT_MS=8000          # connect/statement timeout, 1000..30000

# --- n8n (только workflow из чата/формуляров и внешние интеграции) ---
N8N_WEBHOOK_SECRET=                     # общий секрет HMAC-подписи вебхуков, 32+ байта
# Шифрует credentials во внутреннем volume n8n. Сгенерируйте отдельное случайное
# значение 32+ байта и сохраните вместе с бэкапом: без него credentials не восстановить.
N8N_ENCRYPTION_KEY=
# Ресторан, от имени которого работает агент. Значение — демо-ресторан из db/seed.sql.
RESTAURANT_ID=10000000-0000-0000-0000-000000000001

# --- Telegram (используется workflow n8n; в сообщения не передаются имя и телефон) ---
TELEGRAM_BOT_TOKEN=

# --- Портал ---
# Портал читает этот же корневой .env: его подгружает portal/next.config.ts.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=                    # bcrypt, cost 12; получить командой `pnpm portal:hash`
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD_HASH=
SESSION_SECRET=                         # 32+ байта, подпись httpOnly-cookie
# Локально портал работает по http, и с флагом Secure браузер cookie не сохранит.
# За Caddy (итерация 12) значение обязано стать true.
PORTAL_COOKIE_SECURE=false
# Портал ходит в базу ролью portal_app (PROJECT.md §5.3), а не владельцем схемы.
# Пароль — значение PORTAL_APP_PASSWORD выше; его выставляет `pnpm db:migrate`.
PORTAL_DATABASE_URL=postgres://portal_app:<PORTAL_APP_PASSWORD>@127.0.0.1:55432/restaurant
# Слаг ресторана, которым управляет этот экземпляр портала (restaurants.slug).
# Значение из db/seed.sql — demo.
PORTAL_RESTAURANT_SLUG=demo

# Публичный сайт подключается к базе только серверной ролью website_app. У роли нет прав
# на таблицы — только EXECUTE двух RPC бронирования. Переменные не должны иметь NEXT_PUBLIC_.
WEBSITE_DATABASE_URL=postgres://website_app:<WEBSITE_APP_PASSWORD>@127.0.0.1:55432/restaurant
WEBSITE_RESTAURANT_ID=10000000-0000-0000-0000-000000000001
