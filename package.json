{
  "name": "restaurant-voice-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "description": "Голосовой ИИ-агент для ресторана: бронирование, самовывоз, меню, обратный звонок (DE/RU/EN)",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "agent:dev": "pnpm --filter @hello-table/agent dev",
    "agent:start": "pnpm --filter @hello-table/agent start",
    "agent:download-files": "pnpm --filter @hello-table/agent download-files",
    "dev:token": "node --env-file-if-exists=.env scripts/dev-token.ts",
    "portal:dev": "pnpm --filter @hello-table/portal dev",
    "portal:build": "pnpm --filter @hello-table/portal build",
    "portal:hash": "pnpm --filter @hello-table/portal hash-password",
    "livekit:up": "docker compose -f deploy/docker-compose.dev.yml up -d livekit",
    "livekit:down": "docker compose -f deploy/docker-compose.dev.yml stop livekit",
    "db:up": "docker compose -f deploy/docker-compose.dev.yml up -d postgres",
    "db:down": "docker compose -f deploy/docker-compose.dev.yml stop postgres",
    "db:migrate": "node scripts/db/migrate.ts",
    "db:passwords": "node --env-file-if-exists=.env scripts/db/passwords.ts",
    "db:rollback": "node scripts/db/rollback.ts",
    "db:seed": "node scripts/db/seed.ts",
    "db:reset": "node scripts/db/reset.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && pnpm --filter @hello-table/portal typecheck",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "24.13.3",
    "livekit-server-sdk": "2.17.0",
    "postgres": "3.4.9",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
