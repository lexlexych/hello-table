{
  "name": "restaurant-voice-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Голосовой ИИ-агент для ресторана: бронирование, самовывоз, меню, обратный звонок (DE/RU/EN)",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "db:up": "docker compose -f deploy/docker-compose.dev.yml up -d postgres",
    "db:down": "docker compose -f deploy/docker-compose.dev.yml down",
    "db:migrate": "node scripts/db/migrate.ts",
    "db:rollback": "node scripts/db/rollback.ts",
    "db:seed": "node scripts/db/seed.ts",
    "db:reset": "node scripts/db/reset.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "24.13.3",
    "postgres": "3.4.9",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
