          ]
        },
        "options": {}
      },
      "id": "b60000-0000-4000-8000-000000000001",
      "name": "Upload Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [-760, 0],
      "webhookId": "b60000-0000-4000-8000-000000000999",
      "notes": "Форма, а не чтение с диска: у облачного n8n нет файлов репозитория."
    },
    {
      "parameters": {
        "jsCode": "// Form Trigger называет бинарное свойство по номеру поля, и это имя меняется\n// вместе с формой. Переименовываем первое вложение в data, чтобы Default Data\n// Loader работал со своим значением по умолчанию.\nconst item = $input.first();\nconst binary = item.binary || {};\nconst keys = Object.keys(binary);\n\nif (keys.length === 0) {\n  throw new Error('Файл не загружен: в элементе нет бинарных данных');\n}\n\nconst file = binary[keys[0]];\n\nreturn [{\n  json: { source: file.fileName || 'upload' },\n  binary: { data: file },\n}];"
      },
      "id": "b60000-0000-4000-8000-000000000002",
      "name": "Normalize Upload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-540, 0]
    },
    {
      "parameters": {
        "mode": "insert",
        "qdrantCollection": {
          "__rl": true,
          "value": "basilik_info",
