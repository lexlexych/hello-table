      "name": "When Executed by Agent",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [64, 464]
    },
    {
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "value": "key_value",
          "mode": "name"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "key",
              "keyValue": "portal_api_base_url"
            }
          ]
        },
        "limit": 1
      },
      "id": "83626875-086e-4c2d-ab2e-b4302430d471",
      "name": "Get Portal API URL",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [288, 464],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "notes": "Читает value из Data Table key_value по key = portal_api_base_url."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b20000-0000-4000-8000-000000000100",
              "name": "portal_api_base_url",
              "value": "={{ typeof $json.value === 'string' ? $json.value.replace(/\\/+$/, '') : '' }}",
              "type": "string"
            },
            {
              "id": "b20000-0000-4000-8000-000000000101",
              "name": "date",
              "value": "={{ $('When Executed by Agent').first().json.date }}",
              "type": "string"
            },
            {
              "id": "b20000-0000-4000-8000-000000000102",
              "name": "time",
              "value": "={{ $('When Executed by Agent').first().json.time }}",
              "type": "string"
            },
            {
              "id": "b20000-0000-4000-8000-000000000103",
              "name": "party_size",
              "value": "={{ $('When Executed by Agent').first().json.party_size }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "6426eaaf-d058-400e-9915-6a589228160b",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [512, 464],
      "notes": "Нормализует URL из Data Table и восстанавливает параметры входа. Ресторан портал берёт из PORTAL_RESTAURANT_SLUG."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.portal_api_base_url + '/api/integrations/n8n/availability' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ date: $json.date, time: $json.time, party_size: $json.party_size }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "abccfcdb-1956-4c41-abea-63d909b83497",
      "name": "Find Available Tables",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 464],
      "credentials": {
        "httpHeaderAuth": {
          "id": "gqRw7NDurfwDUOGU",
          "name": "hello-table"
        }
      },
      "onError": "continueRegularOutput",
      "notes": "Выберите HTTP Header Auth credential: Authorization = Bearer <PORTAL_N8N_API_KEY>."
    },
    {
      "parameters": {
        "jsCode": "// Portal API уже вернул типизированный tool envelope. Здесь только fallback\n// для сетевой ошибки HTTP Request, которую n8n пропустил в regular output.\nconst result = $input.first().json;\nif (result?.ok === true || (result?.ok === false && typeof result.error === 'string')) {\n  return [{ json: result }];\n}\nreturn [{ json: { ok: false, error: 'unreachable' } }];"
      },
      "id": "647e654e-8cf3-416b-b347-e3f550fc0f93",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [944, 464]
    },
    {
      "parameters": {
        "content": "## Проверка доступности через Portal API\n\n**Вход:** `date`, `time`, `party_size`.\n\n1. `Get Portal API URL` читает `value` из Data Table `key_value` по ключу `portal_api_base_url`.\n2. `Config` объединяет URL с параметрами входа.\n3. `Find Available Tables` вызывает `POST /api/integrations/n8n/availability`.\n4. `Format Response` возвращает tool envelope агенту.\n\nBearer-секрет хранится только в HTTP Header Auth credential.",
        "height": 340,
        "width": 560,
        "color": 5
      },
      "id": "fd236a81-f98f-4e4d-aabe-2edefa8f5f7c",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [48, 0]
    }
  ],
