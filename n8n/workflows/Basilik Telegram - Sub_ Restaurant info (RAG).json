    {
      "parameters": {
        "jsCode": "// Сабворкфлоу возвращает найденные фрагменты, а не готовый ответ: формулировку\n// выбирает агент-оркестратор на языке клиента. Вторая LLM тут только удорожала бы\n// вызов и спорила бы с оркестратором о словах.\nconst passages = [];\n\nfor (const item of $input.all()) {\n  const doc = item.json && item.json.document ? item.json.document : item.json;\n  const text = doc && doc.pageContent;\n  if (typeof text === 'string' && text.trim().length > 0) {\n    passages.push(text.trim());\n  }\n}\n\nreturn [{ json: { ok: true, found: passages.length > 0, passages } }];"
      },
