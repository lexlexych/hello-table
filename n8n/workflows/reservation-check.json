        "operation": "executeQuery",
        "query": "SELECT COALESCE(\n  jsonb_agg(\n    jsonb_build_object(\n      'table_id', table_id,\n      'label', table_label,\n      'seats', table_seats,\n      'zone', table_zone\n    ) ORDER BY table_seats, table_label\n  ),\n  '[]'::jsonb\n) AS tables\nFROM find_available_tables($1::uuid, $2::date, $3::time, $4::int);",
