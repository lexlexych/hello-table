    },
    {
      "parameters": {
        "jsCode": "const result = $input.first().json;\nif (Array.isArray(result.tables)) {\n  return [{ json: { status: 200, body: { ok: true, tables: result.tables } } }];\n}\n\nconst serialized = JSON.stringify(result);\nif (serialized.includes('45000') || serialized.includes('restaurant_not_found')) {\n  return [{ json: { status: 200, body: { ok: false, error: 'restaurant_not_found' } } }];\n}\n\nreturn [{ json: { status: 500, body: { ok: false, error: 'invalid_request' } } }];"
