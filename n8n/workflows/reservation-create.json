    {
      "parameters": {
        "jsCode": "const result = $input.first().json;\nif (typeof result.reservation_id === 'string') {\n  return [{\n    json: {\n      status: 200,\n      body: {\n        ok: true,\n        reservation_id: result.reservation_id,\n        table_label: result.table_label,\n        starts_at: result.starts_at,\n        ends_at: result.ends_at,\n      },\n    },\n  }];\n}\n\nconst serialized = JSON.stringify(result);\nconst errors = [\n  ['45000', 'restaurant_not_found'],\n  ['45004', 'closed_at_requested_time'],\n  ['45005', 'party_too_large'],\n  ['45006', 'slot_in_past'],\n  ['45015', 'table_not_available'],\n  ['45016', 'table_already_booked'],\n];\n\nfor (const [sqlstate, code] of errors) {\n  if (serialized.includes(sqlstate) || serialized.includes(code)) {\n    return [{ json: { status: 200, body: { ok: false, error: code } } }];\n  }\n}\n\nreturn [{ json: { status: 500, body: { ok: false, error: 'invalid_request' } } }];"
