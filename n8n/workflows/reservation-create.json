        "jsCode": "const item = $input.first().json;\nconst headers = item.headers && typeof item.headers === 'object' ? item.headers : {};\nconst provided = String(headers['x-signature'] ?? '').toLowerCase();\nconst expected = String(item.expected_signature ?? '').toLowerCase();\n\nlet difference = provided.length ^ expected.length;\nconst length = Math.max(provided.length, expected.length);\nfor (let index = 0; index < length; index += 1) {\n  difference |= (provided.charCodeAt(index) || 0) ^ (expected.charCodeAt(index) || 0);\n}\n\nreturn [{ json: { ...item, signature_valid: expected.length === 64 && difference === 0 } }];"
